generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String     @id @default(uuid())
  username  String     @unique
  password  String
  role      Role
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  adminBank AdminBank?
  nasabah   Nasabah?

  @@map("users")
}

model Nasabah {
  id            String          @id @default(uuid())
  userId        String          @unique
  namaNasabah   String
  alamat        String
  telp          String
  tanggalLahir  DateTime?
  foto          String?
  saldoPoin     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  penukaranPoin PenukaranPoin[]
  setorSampah   SetorSampah[]

  @@map("nasabah")
}

model AdminBank {
  id            String   @id @default(uuid())
  userId        String   @unique
  namaUnit      String
  namaPengelola String
  telp          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_bank")
}

model KategoriSampah {
  id           String        @id @default(uuid())
  namaKategori String
  hargaPerKg   Int
  poinPerKg    Int
  jenis        JenisSampah
  foto         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  detailSetor  DetailSetor[]

  @@map("kategori_sampah")
}

model SetorSampah {
  id                String        @id @default(uuid())
  nasabahId         String
  tanggal           DateTime      @default(now())
  totalBeratKg      Float         @default(0)
  totalBeratKgReal  Float?
  estimasiTotalPoin Int           @default(0)
  totalPoinReal     Int?
  status            StatusSetor   @default(menunggu_konfirmasi)
  catatan           String?
  catatanAdmin      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  kodeSetor         String?
  detailSetor       DetailSetor[]
  nasabah           Nasabah       @relation(fields: [nasabahId], references: [id], onDelete: Cascade)

  @@map("setor_sampah")
}

model DetailSetor {
  id               String         @id @default(uuid())
  setorSampahId    String
  kategoriSampahId String
  beratKg          Float
  beratKgReal      Float?
  poinPerKg        Int
  subtotalPoin     Int            @default(0)
  subtotalPoinReal Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  kategoriSampah   KategoriSampah @relation(fields: [kategoriSampahId], references: [id])
  setorSampah      SetorSampah    @relation(fields: [setorSampahId], references: [id], onDelete: Cascade)

  @@map("detail_setor")
}

model Hadiah {
  id             String          @id @default(uuid())
  namaHadiah     String
  deskripsi      String?
  poinDibutuhkan Int
  stok           Int             @default(0)
  foto           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  penukaranPoin  PenukaranPoin[]

  @@map("hadiah")
}

model PenukaranPoin {
  id            String          @id @default(uuid())
  nasabahId     String
  hadiahId      String
  poinDigunakan Int
  status        StatusPenukaran @default(diproses)
  tanggal       DateTime        @default(now())
  catatan       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  kodePenukaran String?
  hadiah        Hadiah          @relation(fields: [hadiahId], references: [id])
  nasabah       Nasabah         @relation(fields: [nasabahId], references: [id], onDelete: Cascade)

  @@map("penukaran_poin")
}

enum Role {
  NASABAH
  ADMIN
}

enum JenisSampah {
  plastik
  kertas
  logam
  kaca
}

enum StatusSetor {
  menunggu_konfirmasi
  diverifikasi
  ditolak
  selesai
}

enum StatusPenukaran {
  diproses
  selesai
}
