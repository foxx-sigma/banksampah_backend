# Database URL (PostgreSQL via PgBouncer or direct)
DATABASE_URL="postgresql://user:password@localhost:5432/banksampah_db?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/banksampah_db?schema=public"

# Server Port
PORT=3001

# Node Environment (development | production)
NODE_ENV="development"

# JWT Secret Key (Generate a high-entropy 256-bit random string)
JWT_SECRET="your_super_secret_random_jwt_key_here"

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs, never *)
FRONTEND_URLS="http://localhost:3000,http://localhost:3001"

# Supabase Storage Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"
SUPABASE_NASABAH_BUCKET="nasabah"
SUPABASE_SAMPAH_BUCKET="kategori-sampah"
SUPABASE_HADIAH_BUCKET="hadiah"

# Optional: Enable Swagger documentation in production (default true in development)
ENABLE_SWAGGER="false"

# Optional: Observe observability integration
OBSERVE_APP_KEY=""
OBSERVE_APP_SECRET=""
